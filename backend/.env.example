# ===================================================================
# Variáveis de Ambiente - FastAPI RAG Chatbot
# Copie este arquivo para .env e preencha os valores
# ===================================================================

# --- Banco de Dados PostgreSQL ---
# Formato: postgresql+asyncpg://usuario:senha@host:porta/banco
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/rag_chatbot

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Autenticação JWT ---
# Gere uma chave segura com: openssl rand -hex 32
JWT_SECRET=sua-chave-secreta-aqui
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Aplicação ---
APP_NAME="RAG Chatbot - Área do Aluno"
APP_VERSION="1.0.0"
DEBUG=true

# --- Upload de Arquivos ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_db

# --- Modelo OpenAI ---
# Opções: gpt-4o-mini, gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
